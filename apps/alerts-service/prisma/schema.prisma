generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["alerts"]
}

enum Severity {
  info
  warning
  critical

  @@schema("alerts")
}

model Alert {
  id          String   @id @default(uuid())
  title       String
  description String
  severity    Severity @default(info)
  metricName  String
  metricValue Float
  threshold   Float
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@schema("alerts")
}
