generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Severity {
  info
  warning
  critical
}

model Alert {
  id          String   @id @default(uuid())
  title       String
  description String
  severity    Severity @default(info)
  metricName  String
  metricValue Float
  threshold   Float
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}
