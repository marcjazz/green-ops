# Build shared package first
RUN pnpm --filter shared run build

# Build the specific app
RUN pnpm --filter alerts-service run build

# Re-install dependencies with local shared package
# Using --no-frozen-lockfile might be necessary if the symlink isn't working as expected,
# but let's try ensuring the shared package is explicitly in the final install.
RUN pnpm install --prod --frozen-lockfile --filter alerts-service
