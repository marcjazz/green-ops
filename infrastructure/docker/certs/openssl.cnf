[req]
default_bits       = 2048
distinguished_name = req_distinguished_name
req_extensions     = req_ext
x509_extensions    = v3_ext
prompt             = no

[req_distinguished_name]
C  = US
ST = State
L  = City
O  = GreenOps
OU = Org
CN = greenops.local

[req_ext]
subjectAltName = @alt_names

[v3_ext]
subjectAltName = @alt_names

[alt_names]
DNS.1   = greenops.local
DNS.2   = accounts.greenops.local
DNS.3   = monitor.greenops.local
