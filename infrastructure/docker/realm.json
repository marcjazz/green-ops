{
  "id": "greenops",
  "realm": "greenops",
  "enabled": true,
  "clients": [
    {
      "clientId": "greenops-frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "redirectUris": ["https://greenops.local/*", "https://greenops.local/", "https://monitor.greenops.local/login/generic_oauth"],
      "webOrigins": ["https://greenops.local", "https://monitor.greenops.local"]
    },
    {
      "clientId": "greenops-grafana",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "your-client-secret",
      "redirectUris": ["https://monitor.greenops.local/login/generic_oauth"],
      "webOrigins": ["https://monitor.greenops.local"]
    }
  ],
  "users": [
    {
      "username": "user1",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "user1password"
        }
      ],
      "realmRoles": ["user"]
    }
  ],
  "roles": {
    "realm": [
      { "name": "user" },
      { "name": "admin" }
    ]
  }
}
