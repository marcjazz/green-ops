{
	"id": "greenops",
	"realm": "greenops",
	"enabled": true,
	"clients": [
		{
			"clientId": "greenops-frontend",
			"enabled": true,
			"protocol": "openid-connect",
			"publicClient": true,
			"directAccessGrantsEnabled": true,
			"redirectUris": [
				"https://greenops.local/*",
				"https://greenops.local/",
				"https://monitor.greenops.local/login/generic_oauth"
			],
			"webOrigins": ["https://greenops.local", "https://monitor.greenops.local"]
		},
		{
			"clientId": "greenops-grafana",
			"enabled": true,
			"protocol": "openid-connect",
			"publicClient": false,
			"secret": "super-secret-grafana-key",
			"redirectUris": ["https://monitor.greenops.local/login/generic_oauth"],
			"webOrigins": ["https://monitor.greenops.local"],
			"protocolMappers": [
				{
					"name": "realm roles",
					"protocol": "openid-connect",
					"protocolMapper": "oidc-usermodel-realm-role-mapper",
					"config": {
						"multivalued": "true",
						"userinfo.token.claim": "true",
						"id.token.claim": "true",
						"access.token.claim": "true",
						"claim.name": "realm_access.roles",
						"jsonType.label": "String"
					}
				}
			]
		}
	],
	"users": [
		{
			"username": "admin",
			"email": "admin@greenops.local",
			"firstName": "Admin",
			"lastName": "User",
			"enabled": true,
			"emailVerified": true,
			"credentials": [
				{
					"type": "password",
					"value": "admin"
				}
			],
			"realmRoles": ["Admin"],
			"requiredActions": []
		},
		{
			"username": "marco.kuidja",
			"email": "marco.kuidja@greenops.local",
			"firstName": "Marco",
			"lastName": "Kuidja",
			"enabled": true,
			"emailVerified": true,
			"credentials": [
				{
					"type": "password",
					"value": "user1password"
				}
			],
			"realmRoles": ["Admin"],
			"requiredActions": []
		}
	],
	"roles": {
		"realm": [{ "name": "Admin" }, { "name": "Editor" }, { "name": "Viewer" }]
	}
}
